# ==========================================================
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA envie o arquivo ".env" para um repositorio publico.
# ==========================================================

# Porta em que o servidor vai rodar
PORT=3000

# Ambiente: development ou production
NODE_ENV=production

# --- Autenticacao do administrador ---
# Usuario do painel admin
ADMIN_USERNAME=admin

# Hash bcrypt da senha do admin (NUNCA coloque a senha em texto puro aqui).
# Gere o hash rodando:  npm run create-admin
# O comando vai perguntar a senha e imprimir o hash pronto para colar aqui.
ADMIN_PASSWORD_HASH=

# --- Sessao ---
# String aleatoria longa e secreta usada para assinar o cookie de sessao.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Nome do cookie de sessao (opcional)
SESSION_COOKIE_NAME=kms_admin_session

# --- Banco de dados ---
# Caminho do arquivo SQLite (sera criado automaticamente)
DATABASE_PATH=./data/keys.db

# --- Rate limiting do login ---
# Numero maximo de tentativas de login por janela de tempo
LOGIN_MAX_ATTEMPTS=5
# Janela de tempo em minutos
LOGIN_WINDOW_MINUTES=15
